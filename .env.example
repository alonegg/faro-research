# Faro Research — copy this to .env and fill in. .env is gitignored.

# ── LLM provider selection ──────────────────────────────────────────────
# One of: "openai_compat" | "anthropic"
FARO_PROVIDER=openai_compat

# OpenAI-compatible (works for OpenAI / DeepSeek / Moonshot / Volcengine Ark / Ollama)
FARO_OPENAI_BASE_URL=https://api.deepseek.com
FARO_OPENAI_API_KEY=
FARO_OPENAI_MODEL=deepseek-chat

# Anthropic (only if FARO_PROVIDER=anthropic)
FARO_ANTHROPIC_API_KEY=
FARO_ANTHROPIC_MODEL=claude-opus-4-7

# ── Data sources ────────────────────────────────────────────────────────
# Tushare token (required for builtin Tushare tools). Apply at https://tushare.pro.
TUSHARE_TOKEN=

# ── Server / storage ────────────────────────────────────────────────────
FARO_DB_PATH=./data/faro.db
FARO_CORS_ORIGINS=http://localhost:5173

# ── Agent loop ──────────────────────────────────────────────────────────
FARO_MAX_TOOL_TURNS=8
FARO_TOOL_RESULT_MAX_CHARS=3500
FARO_LLM_TIMEOUT_SEC=180
