# Faro Research backend — FastAPI + agent + SQLite store.
FROM python:3.12-slim

WORKDIR /app

# Install only what we need — pyproject + source — to maximise layer caching
COPY pyproject.toml README.md LICENSE ./
COPY faro_research ./faro_research

RUN pip install --no-cache-dir -e ".[server]"

# Persisted state lands here (mounted as volume in compose)
RUN mkdir -p /app/data
ENV FARO_DB_PATH=/app/data/faro.db

EXPOSE 8000
CMD ["uvicorn", "faro_research.server.app:app", "--host", "0.0.0.0", "--port", "8000"]
